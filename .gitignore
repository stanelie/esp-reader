# Books. Do not commit these - they are usually someone else's copyright, and
# they are the bulk of the drive.
device/*.txt
!device/demobook.txt

__pycache__/
*.pyc
.DS_Store

# CircuitPython writes this on the drive; it describes the firmware, not the repo.
device/boot_out.txt

# Release build output - rebuild with tools/build_badger_release.py, attach
# to a GitHub release. Binary and version-named, no business in git history.
build/
