+    #if defined(CIRCUITPY_ESP_REAL_LIGHT_SLEEP) && CIRCUITPY_ESP_REAL_LIGHT_SLEEP
+    // Real, power-gated light sleep. Upstream declines to do this because
+    // esp_light_sleep_start() shuts down all non-RTC peripherals, so every
+    // busio/pwmio/keypad object the application holds must be rebuilt after
+    // this returns. Measured on an ESP32-S3: 43 mA for the WFI loop below,
