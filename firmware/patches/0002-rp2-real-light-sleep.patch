 mp_obj_t common_hal_alarm_light_sleep_until_alarms(size_t n_alarms, const mp_obj_t *alarms) {
+    #if CIRCUITPY_RP2_REAL_LIGHT_SLEEP
+    // Before _setup_sleep_alarms(), deliberately.
+    //
+    // That call ends in rtc_set_alarm(), and _light_sleep_clocks_down() moves
+    // clk_rtc from PLL_USB to the crystal. clk_rtc has no glitchless mux, so
+    // switching its source under an already-armed alarm leaves the match
+    // hardware in a state that never fires: the chip sleeps perfectly and
+    // nothing ever wakes it. Measured exactly that way round - 1 mA asleep,
+    // no wake - before the order was swapped. Arm the alarm against the clock
+    // it will actually be counting on.
+    //
+    // The other half of the job is stopping the 1024 Hz supervisor tick.
+    //
+    // Pruning the clocks is only half the job: port_enable_tick() arms a
+    // hardware alarm every 977 us and _tick_callback re-arms it, so the core
+    // is pulled out of WFI a thousand times a second to run background tasks
+    // it has nothing to do. Left running, that alone keeps the chip out of
+    // any low-power state no matter how much of it the masks gate.
+    //
+    // Safe to stop here, for two reasons that both had to be checked rather
+    // than assumed. Monotonic time does not come from these ticks -
+    // port_get_raw_ticks() reads time_us_64(), the free-running hardware
+    // timer, whose clock the mask above deliberately keeps. And neither wake
+    // source is this alarm: a TimeAlarm arms the RTC (rtc_set_alarm), a
+    // PinAlarm arms a GPIO edge, while the tick owns hardware_alarm 0.
+    port_disable_tick();
+    _light_sleep_clocks_down();
+    #endif
+
     _setup_sleep_alarms(false, n_alarms, alarms);
 
     mp_obj_t wake_alarm = mp_const_none;
